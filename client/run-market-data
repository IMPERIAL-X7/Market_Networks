#!/bin/sh
# Launches the Market-Data Client. Arguments are passed straight through:
#   ./client/run-market-data 127.0.0.1 5000 JNST
set -e
here=$(dirname "$0")
root=$(cd "$here/.." && pwd)

# Build on demand so a clean checkout works, but build only this one program:
# the experiment harness allows just a few seconds for the server to start.
# Running "sh tools/build.sh" once beforehand avoids the delay entirely.
if [ ! -x "$root/bin/market_data_client" ]; then
    sh "$root/tools/build.sh" market_data_client >&2
fi

exec "$root/bin/market_data_client" "$@"
