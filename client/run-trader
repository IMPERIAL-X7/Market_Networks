#!/bin/sh
# Launches the Trader Client. Arguments are passed straight through:
#   ./client/run-trader 127.0.0.1 5000 alice
set -e
here=$(dirname "$0")
root=$(cd "$here/.." && pwd)

# Build on demand so a clean checkout works, but build only this one program:
# the experiment harness allows just a few seconds for the server to start.
# Running "sh tools/build.sh" once beforehand avoids the delay entirely.
if [ ! -x "$root/bin/trader_client" ]; then
    sh "$root/tools/build.sh" trader_client >&2
fi

exec "$root/bin/trader_client" "$@"
